# Copy this file to `.env` in the repo root. Never commit `.env`.
# Most settings below have a default. The ones without are marked "no default":
# the three Supabase settings, which the API needs to start, the two
# NEXT_PUBLIC_SUPABASE_ settings, which the web app's sign-in needs, and the
# mailbox settings, which only the two mailbox commands need.
# A setting is added here by the task that first uses it.

# development prints easy-to-read log lines. production prints structured (JSON) lines.
# NODE_ENV=development

# The port the API listens on.
# API_PORT=4100

# How much is logged: error, warn, info or debug.
# LOG_LEVEL=info

# The web app's address. The API lets only pages from this address read its
# answers in a browser (CORS). It must match exactly: scheme, host and port.
# CORS_ORIGIN=http://localhost:3100

# The API's address, as the browser reaches it. Settings that start with
# NEXT_PUBLIC_ are handed to the browser and anyone can read them, so a secret
# never gets that prefix.
# NEXT_PUBLIC_API_URL=http://localhost:4100

# --- Supabase (the database and sign-in) ---
# No default. The API and the company commands (`npm run company:create`,
# `npm run company:add-user`) do not start without them. The keys are on the
# Supabase project's Settings > API Keys page; the address is in its Connect
# dialog.

# The project's address. No slash at the end.
# SUPABASE_URL=https://your-project.supabase.co

# The key that is safe outside the server. It starts with sb_publishable_.
# Row rules decide what it can reach, which for our tables is nothing.
# SUPABASE_PUBLISHABLE_KEY=

# The server key. It starts with sb_secret_. It goes past the row rules and can
# read every company's rows, so it stays on the server and is never given the
# NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY=

# The same project address and publishable key again, for the web app's
# sign-in form, which runs in the browser. They must have the same values as
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY above: if the pairs differ, sign-in
# works but every API call answers 401. Both are safe to show. The secret key
# is never written here with this prefix. Restart `npm run dev:web` after
# changing them.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Mailbox (used so far only by `npm run mailbox:connect` and `npm run mailbox:check`) ---
# These have no default. The two mailbox commands stop with a clear message
# when one is missing. The API, the worker and the web app do not need them yet.

# Siftmerit's own name and password at Google, from the Google Cloud project
# (Google Auth platform > Clients). They identify the app, not any mailbox.
# Both are in the JSON file Google gives when the client is created.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The test mailbox's long-lived secret (refresh token). Development only.
# `npm run mailbox:connect` prints this line. While the Google project is in
# "Testing" it ends after 7 days; then run that command again.
# DEV_MAILBOX_REFRESH_TOKEN=

# Where mailsift listens. mailsift is started in its own terminal, from its
# own folder: npm run dev:env -- --http
# MAILSIFT_URL=http://127.0.0.1:3000/mcp

# Proves to mailsift that we may use it. Copy one key from MCP_SERVER_KEYS in
# mailsift's .env file.
# MAILSIFT_SERVER_KEY=
