# Copy this file to `.env` in the repo root. Never commit `.env`.
# Every setting below has a default, so the API and the worker also start without a `.env` file.
# A setting is added here by the task that first uses it.

# development prints easy-to-read log lines. production prints structured (JSON) lines.
# NODE_ENV=development

# The port the API listens on.
# API_PORT=4100

# How much is logged: error, warn, info or debug.
# LOG_LEVEL=info
