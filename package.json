{
  "name": "siftmerit",
  "version": "0.1.0",
  "private": true,
  "description": "Siftmerit: AI hiring tool. One repo with several parts (API, worker, web app, shared core).",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @siftmerit/api",
    "dev:worker": "npm run dev --workspace @siftmerit/worker",
    "dev:web": "npm run dev --workspace @siftmerit/web",
    "company:create": "npm run company:create --workspace @siftmerit/api --",
    "company:add-user": "npm run company:add-user --workspace @siftmerit/api --",
    "mailbox:connect": "npm run mailbox:connect --workspace @siftmerit/worker",
    "mailbox:check": "npm run mailbox:check --workspace @siftmerit/worker",
    "test-set:send": "npm run test-set:send --workspace @siftmerit/worker --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
