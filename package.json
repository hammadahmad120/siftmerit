{
  "name": "siftmerit",
  "version": "0.1.0",
  "private": true,
  "description": "Siftmerit: AI hiring tool. One repo with several parts (API, worker, web app, shared core).",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @siftmerit/api",
    "dev:worker": "npm run dev --workspace @siftmerit/worker",
    "dev:web": "npm run dev --workspace @siftmerit/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
