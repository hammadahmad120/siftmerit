{
  "name": "@siftmerit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "company:create": "tsx src/scripts/company.ts create",
    "company:add-user": "tsx src/scripts/company.ts add-user",
    "ai:check": "tsx src/scripts/ai-check.ts",
    "requirements:try": "tsx src/scripts/requirements-try.ts"
  },
  "dependencies": {
    "@siftmerit/core": "*",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
